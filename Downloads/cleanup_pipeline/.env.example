# Follow-Up Email Agent — configuration
# Edit values here; the scheduled task reads this file at the start of every run.

# Deal enters the batch when: status=open AND last email was outbound AND
# no inbound reply for >= STALENESS_DAYS
STALENESS_DAYS=5

# Max drafts created per run. Dry-run phase: 3. Raise to 20 after supervised
# runs pass (Phase 3 -> Phase 4 of the implementation plan).
BATCH_CAP=3

# Idempotency: max one draft per deal per DRAFT_COOLDOWN_DAYS
DRAFT_COOLDOWN_DAYS=7

# Draft spec
DRAFT_MIN_WORDS=50
DRAFT_MAX_WORDS=60
DRAFT_MAX_PARAGRAPHS=3

# Folders (relative to this working folder)
DEALS_DIR=deals
RUNS_DIR=runs
