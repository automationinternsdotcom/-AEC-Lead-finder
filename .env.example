# Pipedrive (required)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
# Hash of the Article URL custom field (shared between Lead and Deal entities in
# Pipedrive). Capture via: curl ".../api/v1/dealFields?api_token=..." | jq '.data[] | select(.name=="Article URL").key'
PIPEDRIVE_FIELD_ARTICLE_URL=

# Apollo (optional — if unset, leads create with lead_gap=True in the note).
APOLLO_API_KEY=

# Optional — set to 1 for dry-run mode (no Pipedrive writes; GETs still hit real API).
DRY_RUN=0
