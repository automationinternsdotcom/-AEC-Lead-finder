# Pipedrive (required)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
# Hash of the Article URL custom field (shared between Lead and Deal entities in
# Pipedrive). Capture via: curl ".../api/v1/dealFields?api_token=..." | jq '.data[] | select(.name=="Article URL").key'
PIPEDRIVE_FIELD_ARTICLE_URL=

# Pipedrive custom fields populated by push.py when set. Leaving any blank makes
# the push silently skip that field — useful for stripped-down environments.
# Create them in Pipedrive UI (Settings → Data Fields → Lead) then capture each
# key via the same curl + jq pattern above with select(.name=="<Field Name>").
PIPEDRIVE_FIELD_DATE_POSTED=
PIPEDRIVE_FIELD_LEAD_1=
PIPEDRIVE_FIELD_LEAD_2=
PIPEDRIVE_FIELD_LEAD_3=

# Apollo (optional — if unset, the routine falls through to the Grok enrichment
# path. Leads with no enrichment land in Pipedrive with no Person record and a
# "Contact: (no decision-maker found)" line in the note).
APOLLO_API_KEY=

# Email digest (pipeline.cli.email_digest) — emails the day's new Leads to
# Jordan. All optional; the digest only sends when SMTP_HOST + LEAD_DIGEST_TO +
# LEAD_DIGEST_FROM are set (otherwise it exits 4 with a clear message).
# For Google Workspace use smtp.gmail.com:587 with an App Password as SMTP_PASSWORD.
# Port 465 switches to implicit SSL; anything else uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
LEAD_DIGEST_TO=Jw@aetherclean.com
LEAD_DIGEST_FROM=

# Optional — set to 1 for dry-run mode (no Pipedrive writes; GETs still hit real API).
DRY_RUN=0
