# Required — pipeline aborts at startup if any of these are missing.
ANTHROPIC_API_KEY=
# Optional — if unset, deals create with lead_gap=True (no decision-maker lookup).
APOLLO_API_KEY=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
# Set by scripts/seed_pipedrive.py (run once); plain integers.
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
# Custom field key for the Article URL field on Pipedrive deals (set by Task 6 setup).
PIPEDRIVE_FIELD_ARTICLE_URL=

# Optional knobs (defaults shown).
DRY_RUN=0
MAX_ARTICLES_PER_RUN=50
LOG_LEVEL=INFO
